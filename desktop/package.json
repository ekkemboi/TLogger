{
  "name": "tradelogger-widget",
  "version": "1.0.0",
  "description": "TradeLogger Desktop Widget",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "postinstall": "./scripts/install-desktop-file.sh"
  },
  "dependencies": {
    "chrome-remote-interface": "^0.33.2",
    "electron-reload": "^1.5.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "electron": "33.2.0"
  },
  "build": {
    "appId": "com.tradelogger.widget",
    "productName": "TradeLogger",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/**/*",
      "node_modules/**/*"
    ],
    "protocols": [
      {
        "name": "TradeLogger Protocol",
        "schemes": ["tradelogger"]
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Office",
      "desktop": {
        "StartupWMClass": "tradelogger-widget",
        "MimeType": "x-scheme-handler/tradelogger;"
      }
    }
  }
}
